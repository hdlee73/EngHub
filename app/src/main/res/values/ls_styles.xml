<resources>
    <style name="ls_Theme.Listening" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="colorPrimary">@color/ls_teal_600</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/ls_mint_100</item>
        <item name="colorOnPrimaryContainer">@color/ls_teal_700</item>
        <item name="colorSecondaryContainer">@color/ls_mint_100</item>
        <item name="colorOnSecondaryContainer">@color/ls_teal_700</item>
        <item name="colorSurface">@android:color/white</item>
        <item name="colorOnSurface">@color/ls_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/ls_text_secondary</item>
        <item name="colorOutline">@color/ls_surface_border</item>
        <item name="bottomSheetDialogTheme">@style/ls_ThemeOverlay.Listening.BottomSheet</item>
        <item name="android:windowBackground">@color/ls_navy_950</item>
        <item name="android:colorAccent">@color/ls_blue_500</item>
        <item name="android:statusBarColor">@color/ls_navy_950</item>
        <item name="android:navigationBarColor">@color/ls_navy_950</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="ls_CompactControlButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">46dp</item>
        <item name="android:backgroundTint">@color/ls_surface_border</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ls_text_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">2dp</item>
        <item name="android:paddingRight">2dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>
    <style name="ls_CompactPrimaryButton" parent="ls_CompactControlButton">
        <item name="android:backgroundTint">@color/ls_blue_500</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ls_SecondaryButton" parent="ls_CompactControlButton">
        <item name="android:backgroundTint">@color/ls_mint_100</item>
        <item name="android:textColor">@color/ls_teal_700</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ls_SelectionButton" parent="ls_CompactControlButton">
        <item name="android:layout_height">38dp</item>
        <item name="android:backgroundTint">@color/ls_mint_100</item>
        <item name="android:textColor">@color/ls_text_primary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="ls_MiniButton" parent="ls_CompactControlButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="ls_InlineLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ls_text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="ls_SectionLabel" parent="ls_InlineLabel">
        <item name="android:layout_width">68dp</item>
        <item name="android:textColor">@color/ls_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ls_DarkSpinner">
        <item name="android:layout_height">40dp</item>
        <item name="android:backgroundTint">@color/ls_blue_400</item>
        <item name="android:popupBackground">@color/ls_navy_800</item>
    </style>
    <style name="ls_IconControl" parent="android:Widget.ImageButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/ls_bg_control</item>
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/ls_text_primary</item>
    </style>
    <style name="ls_IconControlPrimary" parent="ls_IconControl">
        <item name="android:background">@drawable/ls_bg_control_primary</item>
        <item name="android:tint">@android:color/white</item>
    </style>
    <style name="ls_HeaderChip" parent="ls_SecondaryButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="iconPadding">4dp</item>
        <item name="iconTint">@color/ls_teal_700</item>
    </style>
    <style name="ls_StepButton" parent="ls_MiniButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="ls_ThemeOverlay.Listening.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:navigationBarColor">@android:color/white</item>
    </style>
    <style name="ls_HeaderIcon" parent="android:Widget.ImageButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/ls_bg_control</item>
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/ls_teal_700</item>
    </style>
    <style name="ls_QuickChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/ls_bg_pill</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textColor">@color/ls_teal_700</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="ls_TimerTile" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:backgroundTint">@color/ls_mint_100</item>
        <item name="android:textColor">@color/ls_teal_700</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">18dp</item>
    </style>
    <style name="ls_PlainIcon" parent="android:Widget.ImageButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">0dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/ls_text_primary</item>
    </style>
    <style name="ls_ToggleIcon" parent="android:Widget.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/ls_bg_toggle</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/ls_text_secondary</item>
    </style>
    <style name="ls_TransportIcon" parent="android:Widget.ImageButton">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/ls_text_primary</item>
    </style>
</resources>

