<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="2dp">

    <TextView
        android:id="@+id/trackState"
        android:layout_width="34dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/ls_text_secondary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/trackName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/ls_text_primary"
        android:textSize="14sp" />

    <ImageButton
        android:id="@+id/trackMore"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="더 보기"
        android:src="@drawable/ls_ic_more"
        app:tint="@color/ls_text_secondary" />

    <ImageView
        android:id="@+id/trackDrag"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="끌어서 순서 변경"
        android:padding="8dp"
        android:src="@drawable/ls_ic_drag"
        app:tint="@color/ls_text_secondary" />
</LinearLayout>
