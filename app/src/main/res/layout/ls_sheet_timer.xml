<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/ls_bg_handle" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="취침 타이머"
        android:textColor="@color/ls_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/timerRemaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/ls_bg_row_current"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="4dp"
        android:text="꺼짐"
        android:textColor="@color/ls_teal_700"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/timerHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ls_bg_row_current"
        android:gravity="center"
        android:paddingBottom="14dp"
        android:text="시간을 고르면 그 시간 뒤에 재생이 멈춥니다"
        android:textColor="@color/ls_text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/timer15"
            style="@style/ls_TimerTile"
            android:text="15분" />

        <Button
            android:id="@+id/timer30"
            style="@style/ls_TimerTile"
            android:text="30분" />

        <Button
            android:id="@+id/timer45"
            style="@style/ls_TimerTile"
            android:text="45분" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/timer60"
            style="@style/ls_TimerTile"
            android:text="60분" />

        <Button
            android:id="@+id/timer90"
            style="@style/ls_TimerTile"
            android:text="90분" />

        <Button
            android:id="@+id/timerEnd"
            style="@style/ls_TimerTile"
            android:text="곡 끝까지" />
    </LinearLayout>

    <Button
        android:id="@+id/timerOff"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="타이머 끄기"
        android:textColor="@color/ls_favorite_active" />
</LinearLayout>
