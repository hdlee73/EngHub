<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/ls_bg_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/sheetBackButton"
            style="@style/ls_HeaderIcon"
            android:layout_marginEnd="8dp"
            android:contentDescription="폴더 목록으로"
            android:src="@drawable/ls_ic_back"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sheetTitle"
            android:layout_width="0dp"
            android:paddingStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="재생목록"
            android:textColor="@color/ls_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/sheetViewButton"
            style="@style/ls_HeaderIcon"
            android:layout_marginEnd="6dp"
            android:contentDescription="보기 방식 바꾸기"
            android:src="@drawable/ls_ic_list" />

        <ImageButton
            android:id="@+id/sheetAddButton"
            style="@style/ls_HeaderIcon"
            android:contentDescription="이 그룹에 파일 추가"
            android:src="@drawable/ls_ic_add" />

        <ImageButton
            android:id="@+id/sheetMenuButton"
            style="@style/ls_HeaderIcon"
            android:layout_marginStart="6dp"
            android:contentDescription="그룹 메뉴"
            android:src="@drawable/ls_ic_more" />
    </LinearLayout>


    <TextView
        android:id="@+id/groupSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:textColor="@color/ls_text_secondary"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/fetchEpisodeButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:backgroundTint="@color/ls_teal_600"
        android:text="6 Minute English 새 에피소드 받기"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:visibility="gone"
        app:cornerRadius="14dp"
        app:icon="@drawable/ls_ic_add"
        app:iconTint="@android:color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/srtAllButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:text="이 폴더 곡 자막(SRT) 만들기"
        android:textColor="@color/ls_teal_700"
        android:visibility="gone"
        app:cornerRadius="14dp"
        app:icon="@drawable/ls_ic_subtitles"
        app:iconTint="@color/ls_teal_700" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/folderGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/trackList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/emptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:padding="32dp"
            android:text="이 폴더는 비어 있어요.\n오른쪽 위 ＋ 버튼으로 파일을 추가하세요."
            android:textColor="@color/ls_text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
