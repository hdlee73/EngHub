<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp">

            <!-- Header: title + the two things that open their own list -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/timerBadge"
                    style="@style/ls_QuickChip"
                    android:layout_marginEnd="8dp"
                    android:text="⏱ 00:00"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/addButton"
                    style="@style/ls_HeaderIcon"
                    android:contentDescription="파일 추가"
                    android:src="@drawable/ls_ic_add" />

                <ImageButton
                    android:id="@+id/playlistButton"
                    style="@style/ls_HeaderIcon"
                    android:layout_marginStart="6dp"
                    android:contentDescription="재생목록"
                    android:src="@drawable/ls_ic_list" />

                <ImageButton
                    android:id="@+id/subtitleButton"
                    style="@style/ls_HeaderIcon"
                    android:layout_marginStart="6dp"
                    android:contentDescription="자막"
                    android:src="@drawable/ls_ic_subtitles" />

                <ImageButton
                    android:id="@+id/timerButton"
                    style="@style/ls_HeaderIcon"
                    android:layout_marginStart="6dp"
                    android:contentDescription="취침 타이머"
                    android:src="@drawable/ls_ic_timer" />

                <ImageButton
                    android:id="@+id/settingsButton"
                    style="@style/ls_HeaderIcon"
                    android:layout_marginStart="6dp"
                    android:contentDescription="설정"
                    android:src="@drawable/ls_ic_settings" />
            </LinearLayout>

            <!-- Now playing, in the style of Apple Music -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/ls_bg_card"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingTop="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/fileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:text="오디오 파일을 추가하세요"
                    android:textColor="@color/ls_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <com.hdlee73.englishstudy.listening.RepeatSeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="18dp"
                    android:progressTint="@color/ls_blue_500"
                    android:thumbTint="@color/ls_blue_400" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/timeText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="00:00"
                        android:textColor="@color/ls_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/remainingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-00:00"
                        android:textColor="@color/ls_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/shuffleButton"
                        style="@style/ls_ToggleIcon"
                        android:contentDescription="그룹 안에서 랜덤 재생"
                        android:src="@drawable/ls_ic_shuffle" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/previousTrackButton"
                        style="@style/ls_TransportIcon"
                        android:contentDescription="이전 곡"
                        android:src="@drawable/ls_ic_fast_rewind" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/playButton"
                        style="@style/ls_TransportIcon"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:contentDescription="재생"
                        android:src="@drawable/ls_ic_play" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/nextTrackButton"
                        style="@style/ls_TransportIcon"
                        android:contentDescription="다음 곡"
                        android:src="@drawable/ls_ic_fast_forward" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/repeatButton"
                        style="@style/ls_ToggleIcon"
                        android:contentDescription="반복 안 함"
                        android:src="@drawable/ls_ic_repeat" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- A-B range -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/ls_bg_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="구간 반복"
                        android:textColor="@color/ls_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/repeatStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="꺼짐"
                        android:textColor="@color/ls_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/abCountPill"
                        style="@style/ls_QuickChip"
                        android:text="횟수 무제한 ▾" />

                    <Button
                        android:id="@+id/clearRepeatButton"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:contentDescription="구간 반복 해제"
                        android:minWidth="0dp"
                        android:text="해제"
                        android:textColor="@color/ls_favorite_active"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/ls_bg_row_current"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <Button
                            android:id="@+id/aButton"
                            style="@style/ls_CompactPrimaryButton"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:contentDescription="현재 위치를 A 시작점으로"
                            android:text="A 지정" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/aMinusButton"
                                style="@style/ls_StepButton"
                                android:backgroundTint="@android:color/white"
                                android:contentDescription="A 지점 앞으로"
                                android:text="−" />

                            <TextView
                                android:id="@+id/aLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:gravity="center"
                                android:text="--:--.-"
                                android:textColor="@color/ls_text_primary"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/aPlusButton"
                                style="@style/ls_StepButton"
                                android:backgroundTint="@android:color/white"
                                android:contentDescription="A 지점 뒤로"
                                android:text="+" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/ls_bg_row_current"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <Button
                            android:id="@+id/bButton"
                            style="@style/ls_CompactPrimaryButton"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:contentDescription="현재 위치를 B 종료점으로"
                            android:text="B 지정" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/bMinusButton"
                                style="@style/ls_StepButton"
                                android:backgroundTint="@android:color/white"
                                android:contentDescription="B 지점 앞으로"
                                android:text="−" />

                            <TextView
                                android:id="@+id/bLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="monospace"
                                android:gravity="center"
                                android:text="--:--.-"
                                android:textColor="@color/ls_text_primary"
                                android:textSize="12sp" />

                            <Button
                                android:id="@+id/bPlusButton"
                                style="@style/ls_StepButton"
                                android:backgroundTint="@android:color/white"
                                android:contentDescription="B 지점 뒤로"
                                android:text="+" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/saveRangeButton"
                        style="@style/ls_SelectionButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="구간 저장" />

                    <Button
                        android:id="@+id/rangeListButton"
                        style="@style/ls_SelectionButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="저장 목록" />
                </LinearLayout>
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
